{
  "name": "medchain",
  "version": "1.0.0",
  "description": "Full-stack blockchain anti-counterfeit medicine traceability (Solidity + Hardhat + Node/Express API + React)",
  "license": "MIT",
  "scripts": {
  "compile": "hardhat compile",
  "test": "hardhat test",
  "coverage": "hardhat coverage",
  "demo": "hardhat run scripts/demo.js",
  "deploy:local": "hardhat run scripts/deploy.js",
  "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
  "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
  "setup": "npm install && npm --prefix backend install && npm --prefix frontend install",
  "chain": "hardhat node",
  "backend": "npm --prefix backend start",
  "frontend": "npm --prefix frontend run dev",
  "seed": "npm --prefix backend run seed",
  "test:backend": "npm --prefix backend test",
  "dev": "concurrently -k -n CHAIN,BACKEND,FRONTEND \"npm run chain\" \"npm run backend\" \"npm run frontend\""
},
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/merkle-tree": "^1.0.7",
    "concurrently": "^10.0.6",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.0"
  }
}
